# Google Cloud Vision API
# Set this to the path of your Google Cloud service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Roboflow API Key
# Get this from your Roboflow account settings: https://roboflow.com/settings/account
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# OpenWeatherMap API Key (Optional, for weather display)
OPENWEATHERMAP_API_KEY=your_openweather_key_here

# Frontend API URL (for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
